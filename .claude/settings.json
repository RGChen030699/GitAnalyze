{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(backend/**)",
      "Edit(frontend/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(python backend/manage.py test:*)",
      "Bash(python backend/manage.py makemigrations:*)",
      "Bash(python backend/manage.py check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(python backend/manage.py migrate:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
