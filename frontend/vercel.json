{
  "rewrites": [
    {
      "source": "/repo/:owner/:name",
      "destination": "/repo.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/:section",
      "destination": "/about.html"
    }
  ]
}
